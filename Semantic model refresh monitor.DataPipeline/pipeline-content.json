{
  "properties": {
    "activities": [
      {
        "type": "TridentNotebook",
        "typeProperties": {
          "notebookId": "4a263b05-dbe1-9406-49a0-6b0cde6de5f1",
          "workspaceId": "00000000-0000-0000-0000-000000000000"
        },
        "policy": {
          "timeout": "0.1:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Semantic model refresh monitor",
        "dependsOn": []
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "items": {
            "value": "@if(\n    equals(activity('Semantic model refresh monitor').output.status, 'Failed'),\n    json(concat('[{\"subject\": \"Semantic model refresh monitor failed\", \"body\": \"🔴 Error has occured\"}, \"email\": \"', pipeline().libraryVariables.Variables_semantic_models_refreshes_notification_email,'\"]')),\n    json(activity('Semantic model refresh monitor').output.result.exitValue)\n)",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Office365Email",
              "typeProperties": {
                "body": "<p>@{item()['body']}</p>",
                "to": {
                  "value": "@item()['email']",
                  "type": "Expression"
                },
                "subject": {
                  "value": "@item()['subject']",
                  "type": "Expression"
                }
              },
              "externalReferences": {
                "connection": "b3151ea0-7cae-49e7-b44f-c82d8ab1bfcf"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Notify",
              "description": "@item()['body']",
              "dependsOn": []
            }
          ]
        },
        "name": "For each notification",
        "dependsOn": [
          {
            "activity": "Semantic model refresh monitor",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ]
      }
    ],
    "libraryVariables": {
      "Variables_semantic_models_refreshes_notification_email": {
        "type": "String",
        "variableName": "semantic_models_refreshes_notification_email",
        "libraryName": "Variables"
      }
    },
    "variables": {
      "notification_body": {
        "type": "String"
      }
    }
  }
}